# Copy to .env (or export) for local runs without Docker Compose.
DATABASE_URL=postgresql+psycopg2://radio:radio@localhost:5432/radio
# Non-negative guard band; same unit as the frequency numbers (examples use MHz).
# INITIAL VALUE ONLY: seeded into a brand-new database. The live setting is
# stored in the database and changed online via POST /api/config/guard-band;
# restarts never overwrite it.
GUARD_BAND=2.0
APP_HOST=0.0.0.0
APP_PORT=8000
# Scheduled auto-approvals: due appointments are processed by a background
# sweep (and once at startup as catch-up). Poll interval in seconds (>= 0.05);
# set SCHEDULED_APPROVAL_BACKGROUND=0 to disable the loop (the startup
# catch-up and POST /api/scheduled-approvals/process-due keep working).
#SCHEDULED_APPROVAL_POLL_SECONDS=0.5
#SCHEDULED_APPROVAL_BACKGROUND=1
